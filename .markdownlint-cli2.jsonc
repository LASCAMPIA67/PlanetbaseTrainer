// Markdown lint rules (https://github.com/DavidAnson/markdownlint-cli2), used locally and by CI.
{
  "config": {
    "default": true,
    // Prose and tables are not wrapped at a fixed width.
    "MD013": false,
    // HTML used on purpose: centered header, screenshot grid, collapsible FAQ answers, keyboard keys.
    "MD033": {
      "allowed_elements": ["a", "b", "br", "details", "div", "img", "kbd", "summary", "table", "td", "tr"]
    },
    // The READMEs start with a centered HTML header.
    "MD041": false,
    // Keep a Changelog repeats the same subsections ("Added", "Fixed"...) in every release.
    "MD024": { "siblings_only": true }
  },
  "globs": ["**/*.md"],
  "ignores": ["**/bin/**", "**/obj/**", "artifacts/**", "**/node_modules/**"]
}
