# Normalize line endings: LF in the repository and in working copies, whatever the platform.
* text=auto eol=lf

# Formats that Windows tools expect with CRLF.
*.sln text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Language-aware diffs.
*.cs text diff=csharp
*.md text diff=markdown

# Binary files.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
*.dll binary
*.pdb binary
