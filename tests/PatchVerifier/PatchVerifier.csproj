<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Static check of every Harmony patch target and reflected member against the installed game,
    without launching it. Run it after each game update (see CONTRIBUTING.md).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RollForward>Major</RollForward>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.14" />
  </ItemGroup>

</Project>
